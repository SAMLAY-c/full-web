{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@repo/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@repo/utils": [
        "../../packages/utils/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app",
    "components",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
